{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es6",
    "outDir": "out",
    "lib": [
      "es6",
      "es2015.core",
      "es2015.collection",
      "es2015.generator",
      "es2015.iterable",
      "es2015.promise",
      "es2015.symbol",
      "es2016.array.include",
      "es2017.object",
      "dom"
    ],
    "sourceMap": true,
    "rootDir": ".",
    "alwaysStrict": true,
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "noImplicitThis": false
  },
  "exclude": ["node_modules", ".vscode-test", "src/dap/test", "src/dap/src/__mocks__", "debug-ui"]
}
